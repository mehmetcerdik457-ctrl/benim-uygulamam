FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt requirements.txt
COPY requirements-test.txt requirements-test.txt
RUN python -m pip install --no-cache-dir -r requirements-test.txt
COPY app /app/app
COPY inspection /app/omega_mvi/inspection
COPY db /app/db
COPY tests /app/tests
COPY model_adapter /app/model_adapter
COPY approval /app/approval
USER 10001:10001
CMD ["python","-m","pytest","-q","-rs","tests/test_postgres_integration.py","tests/test_p0_security.py","tests/test_task_controls.py","tests/test_dashboard_tr.py","tests/test_pipeline_integration.py","model_adapter/test_adapter.py","approval/test_contract.py"]
