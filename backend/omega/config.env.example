# Additional public registration fields for OMEGA-OWNER-API-V1 Android clients.
# Leave the existing legacy OWNER_P256_PUBLIC_KEY_PEM and proxy token unchanged.
# Validate a trusted Android public export: python -m backend.omega.enroll
#   registration.json --verified-owner <independently-verified-owner-id>
OMEGA_OWNER_ID=
OMEGA_DEVICE_ID=
OMEGA_OWNER_PUBLIC_DER_B64=
OMEGA_DEVICE_PUBLIC_DER_B64=
# Mount a persistent private volume at /data before provisioning these paths.
OMEGA_NONCE_DB=/data/omega-nonces.sqlite3
OMEGA_DATA_DB=/data/omega-data.sqlite3
# Existing OPENAI_API_KEY stays in the server vault. Existing OPENAI_MODEL is
# used exactly. No fallback, copied key, or historical model allowlist is used.
