# The existing backend sends chat requests to OpenAI when this is configured.
# Leave empty to run locally without provider credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ALLOWED_MODELS=gpt-5.6-luna,gpt-5.6-terra,gpt-5.6-sol

# Host port for the localhost-only Compose binding.
HOST_PORT=8080

MAX_BODY_BYTES=65536
MAX_MESSAGE_CHARS=32000
MAX_OUTPUT_TOKENS=2048
UPSTREAM_TIMEOUT_SECONDS=45
RATE_LIMIT_PER_MINUTE=20
